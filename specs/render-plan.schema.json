{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.example/schemas/render-plan-2.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document",
    "output_layout"
  ],
  "properties": {
    "schema_version": {
      "const": "render-plan/2"
    },
    "document": {
      "$ref": "#/$defs/layoutIR"
    },
    "output_layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "sections",
        "issues",
        "generated_join_spaces"
      ],
      "properties": {
        "mode": {
          "const": "flow_v1"
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "id",
              "source_pages",
              "page_size_pt",
              "margins_pt",
              "margin_basis",
              "geometry_key",
              "nodes"
            ],
            "properties": {
              "kind": {
                "const": "Section"
              },
              "id": {
                "type": "string"
              },
              "source_pages": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "integer",
                  "minimum": 0
                },
                "uniqueItems": true
              },
              "page_size_pt": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "margins_pt": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "margin_basis": {
                "enum": [
                  "explicit_profile",
                  "measured_body_distribution",
                  "inferred_proportional_margin"
                ]
              },
              "geometry_key": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2
              },
              "nodes": {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/node"
                    },
                    {
                      "$ref": "#/$defs/group"
                    }
                  ]
                }
              }
            }
          }
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "generated_join_spaces": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "source_ids",
        "style_id",
        "width_pt",
        "alignment",
        "indent_pt",
        "right_indent_pt",
        "space_before_pt",
        "space_after_pt",
        "line_spacing",
        "keep_with_next",
        "widow_control",
        "runs",
        "joiners",
        "height_limit_pt"
      ],
      "properties": {
        "kind": {
          "enum": [
            "Paragraph",
            "Figure",
            "Table"
          ]
        },
        "id": {
          "type": "string"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "heading_level": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 9
        },
        "style_id": {
          "enum": [
            "body",
            "heading",
            "caption",
            "footer"
          ]
        },
        "width_pt": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "alignment": {
          "enum": [
            "left",
            "center",
            "right",
            "justify"
          ]
        },
        "indent_pt": {
          "type": "number",
          "minimum": 0
        },
        "first_line_indent_pt": {
          "type": "number"
        },
        "right_indent_pt": {
          "type": "number",
          "minimum": 0
        },
        "space_before_pt": {
          "type": "number",
          "minimum": 0
        },
        "space_after_pt": {
          "type": "number",
          "minimum": 0
        },
        "line_spacing": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "keep_with_next": {
          "type": "boolean"
        },
        "widow_control": {
          "type": "boolean"
        },
        "runs": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ascii",
                "hAnsi",
                "eastAsia",
                "font_size_pt",
                "bold",
                "italic",
                "underline",
                "superscript",
                "subscript",
                "color",
                "source_font",
                "font_mapping_basis"
              ],
              "properties": {
                "ascii": {
                  "type": "string",
                  "minLength": 1
                },
                "hAnsi": {
                  "type": "string",
                  "minLength": 1
                },
                "eastAsia": {
                  "type": "string",
                  "minLength": 1
                },
                "font_size_pt": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "bold": {
                  "type": "boolean"
                },
                "italic": {
                  "type": "boolean"
                },
                "underline": {
                  "type": "boolean"
                },
                "superscript": {
                  "type": "boolean"
                },
                "subscript": {
                  "type": "boolean"
                },
                "color": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "inherit_fonts": {"type": "boolean"},
                "inherit_base": {
                  "type": "boolean"
                },
                "source_font": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "font_mapping_basis": {
                  "enum": [
                    "source_family_available",
                    "explicit_output_fallback",
                    "verified_local_source_family",
                    "configured_local_substitution_reflow_risk",
                    "missing_or_opaque_source_family_reflow_risk"
                  ]
                }
              }
            }
          }
        },
        "joiners": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "",
              " "
            ]
          }
        },
        "height_limit_pt": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "source_ids",
        "children",
        "width_pt",
        "group_type"
      ],
      "properties": {
        "kind": {
          "const": "Group"
        },
        "id": {
          "type": "string"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "width_pt": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "group_type": {
          "enum": [
            "text_groups",
            "figure_groups"
          ]
        }
      }
    },
    "layoutIR": {
      "title": "PDF2Word Layout IR 1.2",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "document_id",
        "source",
        "metadata",
        "pages",
        "styles",
        "assets",
        "relations",
        "issues",
        "provenance",
        "metrics",
        "model_registry",
        "output_styles",
        "planning"
      ],
      "properties": {
        "schema_version": {
          "const": "layout-ir/1.2"
        },
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/$defs/layoutIR/$defs/sourceDocument"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        },
        "pages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/layoutIR/$defs/page"
          }
        },
        "styles": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/layoutIR/$defs/style"
          }
        },
        "assets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/layoutIR/$defs/asset"
          }
        },
        "relations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/layoutIR/$defs/relation"
          }
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/layoutIR/$defs/issue"
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": true
        },
        "metrics": {
          "type": "object",
          "additionalProperties": true
        },
        "model_registry": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "output_styles": {
          "type": "object",
          "required": [
            "body",
            "heading",
            "caption",
            "footer"
          ],
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "font_size_pt",
              "latin_font",
              "east_asia_font",
              "basis",
              "alignment",
              "space_before_pt",
              "space_after_pt",
              "line_spacing"
            ],
            "properties": {
              "font_size_pt": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "latin_font": {
                "type": "string",
                "minLength": 1
              },
              "east_asia_font": {
                "type": "string",
                "minLength": 1
              },
              "basis": {
                "type": "string"
              },
              "alignment": {
                "enum": [
                  "left",
                  "center",
                  "right",
                  "justify"
                ]
              },
              "space_before_pt": {
                "type": "number",
                "minimum": 0
              },
              "space_after_pt": {
                "type": "number",
                "minimum": 0
              },
              "line_spacing": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        },
        "planning": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile",
            "source_ir_sha256",
            "source_schema_version",
            "profile_settings"
          ],
          "properties": {
            "profile": {
              "const": "flow-v1"
            },
            "source_ir_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "source_schema_version": {
              "enum": [
                "layout-ir/1.1",
                "layout-ir/1.2"
              ]
            },
            "profile_settings": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "body_size_pt": {
                  "type": "number",
                  "minimum": 4,
                  "maximum": 200
                },
                "latin_font": {
                  "type": "string",
                  "minLength": 1
                },
                "east_asia_font": {
                  "type": "string",
                  "minLength": 1
                },
                "margins_pt": {
                  "type": "array",
                  "minItems": 4,
                  "maxItems": 4,
                  "items": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "page_size_pt": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "editable_styles": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      },
      "$defs": {
        "bbox": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "minItems": 4,
          "maxItems": 4
        },
        "sourceDocument": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "filename",
            "sha256",
            "page_count"
          ],
          "properties": {
            "filename": {
              "type": "string"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{64}$"
            },
            "page_count": {
              "type": "integer",
              "minimum": 1
            },
            "pdf_version": {
              "type": [
                "string",
                "null"
              ]
            },
            "encrypted": {
              "type": "boolean",
              "default": false
            }
          }
        },
        "page": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "page_index",
            "width_pt",
            "height_pt",
            "rotation",
            "page_type",
            "classification_confidence",
            "blocks",
            "reading_order",
            "source_refs",
            "complexity_score",
            "routing_decision",
            "model_calls"
          ],
          "properties": {
            "page_index": {
              "type": "integer",
              "minimum": 0
            },
            "label": {
              "type": [
                "string",
                "null"
              ]
            },
            "width_pt": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "height_pt": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "rotation": {
              "type": "integer",
              "enum": [
                0,
                90,
                180,
                270
              ]
            },
            "page_type": {
              "type": "string",
              "enum": [
                "native",
                "mixed",
                "scanned",
                "hidden_text_scan",
                "broken_encoding",
                "image_dominant",
                "unknown"
              ]
            },
            "classification_confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "blocks": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/layoutIR/$defs/block"
              }
            },
            "reading_order": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "source_refs": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "complexity_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "routing_decision": {
              "type": "string"
            },
            "model_calls": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "geometry_candidates": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/layoutIR/$defs/geometryCandidate"
              }
            },
            "selected_geometry_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "geometry_rejections": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "provider",
                  "index",
                  "reason"
                ],
                "properties": {
                  "provider": {
                    "enum": [
                      "native",
                      "pp",
                      "monkey"
                    ]
                  },
                  "index": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "reason": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "block": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "page_index",
            "bbox",
            "rotation",
            "source_type",
            "engine",
            "engine_version",
            "content",
            "children",
            "relations",
            "provenance_refs",
            "flags",
            "engine_confidence",
            "system_confidence",
            "geometry_source",
            "content_candidates",
            "selected_candidate_id",
            "render_policy"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "type": {
              "type": "string",
              "enum": [
                "section",
                "major_question",
                "question",
                "subquestion",
                "paragraph",
                "heading",
                "list",
                "list_item",
                "option",
                "text_line",
                "text_span",
                "figure",
                "caption",
                "table",
                "table_row",
                "table_cell",
                "formula",
                "header",
                "footer",
                "page_number",
                "answer_area",
                "layout_container",
                "unknown"
              ]
            },
            "page_index": {
              "type": "integer",
              "minimum": 0
            },
            "bbox": {
              "$ref": "#/$defs/layoutIR/$defs/bbox"
            },
            "rotation": {
              "type": "number"
            },
            "source_type": {
              "type": "string",
              "enum": [
                "native_pdf",
                "pdf_image",
                "pdf_vector_render",
                "pp_ocr_v6",
                "pp_doclayout",
                "pp_structure",
                "pp_formula",
                "ovis_ocr2",
                "monkeyocrv2",
                "inferred",
                "manual_correction",
                "fused"
              ]
            },
            "engine": {
              "type": "string"
            },
            "engine_version": {
              "type": "string"
            },
            "style_ref": {
              "type": [
                "string",
                "null"
              ]
            },
            "content": {
              "$ref": "#/$defs/layoutIR/$defs/content"
            },
            "children": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "relations": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "provenance_refs": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "flags": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "engine_confidence": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            },
            "system_confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "geometry_source": {
              "type": "string",
              "enum": [
                "native_pdf",
                "pdf_image",
                "pdf_vector_render",
                "pp_doclayout",
                "pp_ocr_v6",
                "pp_structure",
                "pp_formula",
                "monkeyocrv2",
                "ovis_ocr2",
                "manual_correction",
                "fused",
                "inferred"
              ]
            },
            "content_candidates": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/layoutIR/$defs/contentCandidate"
              }
            },
            "selected_candidate_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "render_policy": {
              "type": "string",
              "enum": [
                "editable",
                "preserve_image",
                "hybrid",
                "review_required"
              ]
            },
            "selected_geometry_id": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "content": {
          "oneOf": [
            {
              "$ref": "#/$defs/layoutIR/$defs/textContent"
            },
            {
              "$ref": "#/$defs/layoutIR/$defs/imageContent"
            },
            {
              "$ref": "#/$defs/layoutIR/$defs/formulaContent"
            },
            {
              "$ref": "#/$defs/layoutIR/$defs/tableContent"
            },
            {
              "$ref": "#/$defs/layoutIR/$defs/containerContent"
            }
          ]
        },
        "textContent": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "plain_text",
            "runs",
            "language_hints"
          ],
          "properties": {
            "kind": {
              "const": "text"
            },
            "plain_text": {
              "type": "string"
            },
            "runs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/layoutIR/$defs/textRun"
              }
            },
            "language_hints": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            }
          }
        },
        "textRun": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text",
            "bbox",
            "font_family",
            "font_size_pt",
            "bold",
            "italic",
            "underline",
            "superscript",
            "subscript",
            "color",
            "confidence",
            "source_ref"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "bbox": {
              "$ref": "#/$defs/layoutIR/$defs/bbox"
            },
            "font_family": {
              "type": [
                "string",
                "null"
              ]
            },
            "font_size_pt": {
              "type": [
                "number",
                "null"
              ],
              "exclusiveMinimum": 0
            },
            "bold": {
              "type": "boolean"
            },
            "italic": {
              "type": "boolean"
            },
            "underline": {
              "type": "boolean"
            },
            "superscript": {
              "type": "boolean"
            },
            "subscript": {
              "type": "boolean"
            },
            "color": {
              "type": [
                "string",
                "null"
              ]
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "source_ref": {
              "type": "string"
            }
          }
        },
        "imageContent": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "asset_id",
            "content_mode",
            "render_mode",
            "ocr_mode",
            "placement_hint",
            "internal_text"
          ],
          "properties": {
            "kind": {
              "const": "image"
            },
            "asset_id": {
              "type": "string"
            },
            "content_mode": {
              "type": "string",
              "enum": [
                "figure",
                "figure_with_internal_text",
                "raster_text",
                "vector_composite",
                "page_fallback"
              ]
            },
            "render_mode": {
              "type": "string",
              "enum": [
                "preserve_as_image",
                "editable_text",
                "metadata_only"
              ]
            },
            "ocr_mode": {
              "type": "string",
              "enum": [
                "none",
                "metadata_only",
                "replace_image",
                "review"
              ]
            },
            "placement_hint": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                null,
                "inline",
                "below_stem",
                "right_of_stem",
                "option_grid",
                "full_width",
