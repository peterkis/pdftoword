# PDF2Word Local V1.1 — model service configuration example.
#
# Copy to .env.local. The direct endpoints below use local FRP visitors.
# .env.local is gitignored: never commit private server addresses or API keys.
# Loopback examples are safe; the gateway placeholder is not a deployed service.

# --- Unified model gateway: the only endpoint the application itself calls ---
MODEL_GATEWAY_BASE_URL=http://MODEL_SERVER_IP:8100

# --- Direct service endpoints --------------------------------------------
# Used only by controlled T0015-T0017 Gate tools. Production application
# traffic must use the gateway instead of these provider ports.
MONKEY_BASE_URL=http://127.0.0.1:9000
MONKEY_MODEL=MonkeyOCRv2

OVIS_BASE_URL=http://127.0.0.1:8000
OVIS_MODEL=ovis-ocr2

PP_BASE_URL=http://127.0.0.1:8080
# Endpoint/transport are discovered from current OpenAPI, not forced by this file.

# --- Timeouts and concurrency ---------------------------------------------
MODEL_CONNECT_TIMEOUT_SECONDS=10
MODEL_REQUEST_TIMEOUT_SECONDS=600

MONKEY_MAX_CONCURRENCY=1
OVIS_MAX_CONCURRENCY=1
PADDLE_MAX_CONCURRENCY=1

# Legacy aliases remain supported: MONKEY_OPENAI_BASE_URL,
# OVIS_OPENAI_BASE_URL, PP_STRUCTURE_BASE_URL. OpenAI /v1 is added by the tool.

# This deployment requires no API key (operator confirmed).
MONKEY_API_KEY=
OVIS_API_KEY=
PADDLE_API_KEY=
NO_PROXY=127.0.0.1,localhost
no_proxy=127.0.0.1,localhost
# CLI security confirmation is explicit; these empty values are not proof of rotation.

# Current observed PP contract: POST /layout-parsing, JSON Base64.
# Source of truth: specs/discovered-model-contracts.json (generated by the Gate).
